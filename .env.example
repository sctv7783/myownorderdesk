# Server-side Supabase Configuration (Backend only, never expose to client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Groq AI Configuration (MANDATORY: openai/gpt-oss-20b)
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"

# Meta WhatsApp Cloud API Configuration
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_ACCESS_TOKEN="your-system-user-access-token"
META_VERIFY_TOKEN="orderdesk_webhook_verify_token_secure"
META_GRAPH_API_VERSION="v21.0"

# Application URL
APP_URL="https://whats-app-orderdesk.netlify.app"
PORT=3000

